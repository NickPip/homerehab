# Google Analytics 4 measurement ID. Leave empty to disable analytics (e.g. locally).
NEXT_PUBLIC_GA_ID=

# Google Search Console "HTML tag" verification token (the content="..." value only).
# The live token is checked into app/layout.tsx, since it is public by construction. Set this only
# to override it, e.g. if the Search Console property is re-created and issues a new token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Comma-separated profile URLs emitted as schema.org sameAs (Google Business Profile, Facebook,
# Instagram). Linking the Business Profile here helps Google connect the site to the local listing.
NEXT_PUBLIC_SAME_AS=

# Google Business Profile "write a review" short link (g.page/r/<id>/review).
# The review call-to-action in the footer is hidden entirely while this is empty.
NEXT_PUBLIC_GBP_REVIEW_URL=
